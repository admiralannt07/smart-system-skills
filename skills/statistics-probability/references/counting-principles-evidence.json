    "units": [
      {
        "type": "exercise",
        "statement": "Two bread choices and three fillings yield six possible menus if all pairs are allowed.",
        "concepts": [
          "counting-principles"
        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:17/shape:340",
            "quote": "\tTebak-tebakan: Menu sarapan"
          },
          {
            "locator": "slide:17/shape:342",
            "quote": "\tTEMA 2  /  ATURAN PERKALIAN"
          },
          {
            "locator": "slide:17/shape:346",
            "quote": "\tAYO TEBAK DULU"
          },
          {
            "locator": "slide:17/shape:347",
            "quote": "\tWarung menyediakan 2 jenis roti dan 3 jenis isian. Setiap pembeli memilih satu roti dan satu isian. Ada berapa menu?"
          },
          {
            "locator": "slide:17/shape:349",
            "quote": "\tPETUNJUK"
          },
          {
            "locator": "slide:17/shape:350",
            "quote": "\tA. 5 menu"
          }
        ],
        "references": []
      }
    ]
  },
  {
    "slide": 18,
    "source_sha256": "ab7efabed9af6dec3f902abc3a0143f0301a0383fdce951490fd26e869d5ef1f",
    "summary": "Enumerating both branches verifies a two-by-three product of six.",
    "issues": [],
    "limitations": [],
    "units": [
      {
        "type": "worked-example",
        "statement": "Enumerating both branches verifies a two-by-three product of six.",
        "concepts": [
          "counting-principles"
        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:18/shape:353",
            "quote": "\tJawaban: bukan dijumlahkan"
          },
          {
            "locator": "slide:18/shape:355",
            "quote": "\tTEMA 2  /  ATURAN PERKALIAN"
          },
          {
            "locator": "slide:18/shape:360",
            "quote": "\t1"
          },
          {
            "locator": "slide:18/shape:361",
            "quote": "\tPilih roti A → bisa disandingkan dengan isi 1, 2, atau 3."
          },
          {
            "locator": "slide:18/shape:364",
            "quote": "\t2"
          },
          {
            "locator": "slide:18/shape:365",
            "quote": "\tPilih roti B → bisa disandingkan dengan isi 1, 2, atau 3."
          },
          {
            "locator": "slide:18/shape:368",
            "quote": "\t3"
          },
          {
            "locator": "slide:18/shape:369",
            "quote": "\tDaftar hasil: A1, A2, A3, B1, B2, B3."
          },
          {
            "locator": "slide:18/shape:372",
            "quote": "\t4"
          },
          {
            "locator": "slide:18/shape:373",
            "quote": "\tDua tahap dengan masing-masing 2 dan 3 opsi memberi 2 × 3 = 6 hasil."
          }
        ],
        "references": []
      }
    ]
  },
  {
    "slide": 19,
    "source_sha256": "ab7efabed9af6dec3f902abc3a0143f0301a0383fdce951490fd26e869d5ef1f",
    "summary": "Multiply fixed branching counts; when counts depend on earlier choices, count branches and add. N here denotes a count, not a population-size assertion.",
    "issues": [],
    "limitations": [],
    "units": [
      {
        "type": "formula",
        "statement": "Multiply fixed branching counts; when counts depend on earlier choices, count branches and add. N here denotes a count, not a population-size assertion.",
        "concepts": [
          "counting-principles"
        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:19/shape:376",
            "quote": "\tDefinisi: aturan perkalian pencacahan"
          },
          {
            "locator": "slide:19/shape:378",
            "quote": "\tTEMA 2  /  ATURAN PERKALIAN"
          },
          {
            "locator": "slide:19/shape:382",
            "quote": "\t𝑵 = 𝒏₁ × 𝒏₂ × ⋯ × 𝒏ₖ"
          },
          {
            "locator": "slide:19/shape:384",
            "quote": "\tDEFINISI"
          },
          {
            "locator": "slide:19/shape:385",
            "quote": "\tAturan perkalian (multiplication principle) menyatakan bahwa apabila suatu proses terdiri atas dua tahap, tahap pertama mempunyai 𝑚 pilihan dan setiap pilihan tahap pertama dapat dilanjutkan dengan 𝑛 pilihan pada tahap kedua, maka banyaknya kemungkinan keseluruhan adalah 𝑚𝑛."
          },
          {
            "locator": "slide:19/shape:387",
            "quote": "\tKAPAN DIPAKAI?"
          },
          {
            "locator": "slide:19/shape:388",
            "quote": "\tJumlah opsi tahap lanjutan boleh berubah; jika berubah, hitung per cabang dan jumlahkan."
          }
        ],
        "references": []
      },
