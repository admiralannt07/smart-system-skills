    "units": [
      {
        "type": "exercise",
        "statement": "Count unrestricted choices and remove prohibited device-payment combinations across both roles.",
        "concepts": [
          "counting-principles"
        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:24/shape:460",
            "quote": "\tLatihan Tema 2: Tiga soal"
          },
          {
            "locator": "slide:24/shape:462",
            "quote": "\tTEMA 2  /  ATURAN PERKALIAN"
          },
          {
            "locator": "slide:24/shape:466",
            "quote": "\tKERJAKAN BERPASANGAN"
          },
          {
            "locator": "slide:24/shape:469",
            "quote": "\t1"
          },
          {
            "locator": "slide:24/shape:470",
            "quote": "\tAda 3 minuman dan 2 ukuran gelas. Berapa paket minuman berbeda?"
          },
          {
            "locator": "slide:24/shape:473",
            "quote": "\t2"
          },
          {
            "locator": "slide:24/shape:474",
            "quote": "\tEmpat browser, tiga jaringan, dua bahasa. Berapa konfigurasi pengujian?"
          },
          {
            "locator": "slide:24/shape:477",
            "quote": "\t3"
          },
          {
            "locator": "slide:24/shape:478",
            "quote": "\tAda 3 perangkat, 2 metode bayar, 2 peran pengguna. Satu metode tidak ada di 1 perangkat (untuk dua peran). Berapa konfigurasi sah?"
          },
          {
            "locator": "slide:24/shape:479",
            "quote": "\tTuliskan: apa yang dihitung, aturan yang dipakai, dan alasannya."
          }
        ],
        "references": []
      }
    ]
  },
  {
    "slide": 25,
    "source_sha256": "ab7efabed9af6dec3f902abc3a0143f0301a0383fdce951490fd26e869d5ef1f",
    "summary": "The source solutions give six packages, 24 configurations, and ten valid restricted configurations.",
    "issues": [],
    "limitations": [],
    "units": [
      {
        "type": "worked-example",
        "statement": "The source solutions give six packages, 24 configurations, and ten valid restricted configurations.",
        "concepts": [
          "counting-principles"
        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:25/shape:482",
            "quote": "\tPembahasan Tema 2"
          },
          {
            "locator": "slide:25/shape:484",
            "quote": "\tTEMA 2  /  ATURAN PERKALIAN"
          },
          {
            "locator": "slide:25/shape:488",
            "quote": "\t1."
          },
          {
            "locator": "slide:25/shape:489",
            "quote": "\tSatu jenis minuman dan satu ukuran → 3 × 2 = 6 paket."
          },
          {
            "locator": "slide:25/shape:491",
            "quote": "\t2."
          },
          {
            "locator": "slide:25/shape:492",
            "quote": "\tBrowser × jaringan × bahasa → 4 × 3 × 2 = 24 konfigurasi."
          },
          {
            "locator": "slide:25/shape:494",
            "quote": "\t3."
          },
          {
            "locator": "slide:25/shape:495",
            "quote": "\tTotal teoretis 3 × 2 × 2 = 12; yang terlarang 1 × 1 × 2 = 2, jadi 10 sah."
          },
          {
            "locator": "slide:25/shape:496",
            "quote": "\tJangan hanya menghafal hasil: pahami model dan asumsi di belakangnya."
          }
        ],
        "references": []
      }
    ]
  }
