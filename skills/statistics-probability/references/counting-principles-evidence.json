    "units": [
      {
        "type": "worked-example",
        "statement": "Three tops, two bottoms, and two shoe pairs give twelve outfits under compatibility assumptions.",
        "concepts": [
          "counting-principles"
        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:20/shape:391",
            "quote": "\tContoh harian: Memilih pakaian"
          },
          {
            "locator": "slide:20/shape:393",
            "quote": "\tTEMA 2  /  ATURAN PERKALIAN"
          },
          {
            "locator": "slide:20/shape:397",
            "quote": "\tJUMLAH OUTFIT"
          },
          {
            "locator": "slide:20/shape:398",
            "quote": "\t12 cara"
          },
          {
            "locator": "slide:20/shape:399",
            "quote": "\t3 atasan × 2 bawahan × 2 pasang sepatu. Asumsinya semua pasangan bisa digunakan."
          },
          {
            "locator": "slide:20/shape:401",
            "quote": "\tMakna: tidak perlu mencoba satu per satu untuk menghitung seluruh kombinasi gaya. Jika ada pasangan yang tidak cocok, coret kombinasi terlarang."
          }
        ],
        "references": []
      }
    ]
  },
  {
    "slide": 21,
    "source_sha256": "ab7efabed9af6dec3f902abc3a0143f0301a0383fdce951490fd26e869d5ef1f",
    "summary": "Four browsers, three operating systems, and two languages give 24 configurations if all are feasible.",
    "issues": [],
    "limitations": [],
    "units": [
      {
        "type": "worked-example",
        "statement": "Four browsers, three operating systems, and two languages give 24 configurations if all are feasible.",
        "concepts": [
          "counting-principles"
        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:21/shape:404",
            "quote": "\tContoh TI: Konfigurasi pengujian"
          },
          {
            "locator": "slide:21/shape:406",
            "quote": "\tTEMA 2  /  ATURAN PERKALIAN"
          },
          {
            "locator": "slide:21/shape:410",
            "quote": "\tFULL COMBINATIONS"
          },
          {
            "locator": "slide:21/shape:411",
            "quote": "\t24 tes"
          },
          {
            "locator": "slide:21/shape:412",
            "quote": "\t4 browser × 3 sistem operasi × 2 bahasa = 24 skenario konfigurasi."
          },
          {
            "locator": "slide:21/shape:414",
            "quote": "\tMakna keputusan: saat tiap konfigurasi dianggap layak, pengujian menyeluruh mencakup 24 skenario. Jika ada kombinasi browser OS tidak kompatibel, hitung ulang."
          }
        ],
        "references": []
      }
    ]
  },
  {
    "slide": 22,
    "source_sha256": "ab7efabed9af6dec3f902abc3a0143f0301a0383fdce951490fd26e869d5ef1f",
    "summary": "Twenty-four sequential six-minute scenarios require 144 minutes under the explicitly stated timing assumptions.",
    "issues": [],
    "limitations": [],
    "units": [
      {
        "type": "worked-example",
        "statement": "Twenty-four sequential six-minute scenarios require 144 minutes under the explicitly stated timing assumptions.",
        "concepts": [
          "counting-principles"
        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:22/shape:417",
            "quote": "\tDari jumlah tes menuju keputusan waktu"
          },
          {
            "locator": "slide:22/shape:419",
            "quote": "\tTEMA 2  /  ATURAN PERKALIAN"
          },
          {
            "locator": "slide:22/shape:423",
            "quote": "\tASUMSI SIMULASI"
          },
          {
            "locator": "slide:22/shape:424",
            "quote": "\t144 menit"
          },
          {
            "locator": "slide:22/shape:425",
            "quote": "\tJika setiap dari 24 skenario memerlukan 6 menit dan diuji berurutan tanpa waktu tambahan, maka waktu yang diperlukan 24 × 6 = 144 menit."
          },
          {
            "locator": "slide:22/shape:427",
            "quote": "\tMakna: hasilnya estimasi awal beban kerja, bukan durasi nyata. Akan tetapi, pengujian paralel, dan setup dapat mengubah durasi."
          }
        ],
        "references": []
      }
    ]
  },
  {
    "slide": 23,
    "source_sha256": "ab7efabed9af6dec3f902abc3a0143f0301a0383fdce951490fd26e869d5ef1f",
    "summary": "Remove one forbidden device-payment pair from six otherwise possible pairs to obtain five.",
    "issues": [],
    "limitations": [],
    "units": [
      {
        "type": "worked-example",
        "statement": "Remove one forbidden device-payment pair from six otherwise possible pairs to obtain five.",
        "concepts": [
          "counting-principles"
        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:23/shape:430",
            "quote": "\tPerkalian tidak selalu lurus"
          },
          {
            "locator": "slide:23/shape:432",
            "quote": "\tTEMA 2  /  ATURAN PERKALIAN"
          },
          {
            "locator": "slide:23/shape:436",
            "quote": "\tKONDISI IDEAL"
          },
          {
            "locator": "slide:23/shape:437",
            "quote": "\t3 metode bayar (QR, Chash, Transfer)  × 2 perangkat, maka 6 pilihan konfigurasi bisa digunakan apabila SEMUA metode tersedia pada KEDUA perangkat."
          },
          {
            "locator": "slide:23/shape:439",
            "quote": "\tADA BATASAN"
          },
          {
            "locator": "slide:23/shape:440",
            "quote": "\tJika metode QR hanya bisa di perangkat A, pasangan (B, QR) tidak diizinkan; yang tersisa hanya 5 konfigurasi."
          },
          {
            "locator": "slide:23/shape:442",
            "quote": "\tKeputusan benar membutuhkan daftar kendala, bukan sekadar mengalikan angka."
          }
        ],
        "references": []
      }
    ]
  },
  {
    "slide": 24,
    "source_sha256": "ab7efabed9af6dec3f902abc3a0143f0301a0383fdce951490fd26e869d5ef1f",
    "summary": "Count unrestricted choices and remove prohibited device-payment combinations across both roles.",
    "issues": [],
