        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:67/shape:2",
            "quote": "Skewness"
          },
          {
            "locator": "slide:67/shape:3",
            "quote": "Ukuran kemencengan distribusi"
          },
          {
            "locator": "slide:67/shape:6",
            "quote": "• Skewness ≈ 0: distribusi relatif simetris."
          },
          {
            "locator": "slide:67/shape:7",
            "quote": "Skewness ≈ (3(x̄ − Me)) / s"
          },
          {
            "locator": "slide:67/shape:8",
            "quote": "Contoh"
          },
          {
