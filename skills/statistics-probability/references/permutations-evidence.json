  {
    "slide": 28,
    "source_sha256": "ab7efabed9af6dec3f902abc3a0143f0301a0383fdce951490fd26e869d5ef1f",
    "summary": "Four choices followed by three remaining choices give twelve ordered officers.",
    "issues": [],
    "limitations": [],
    "units": [
      {
        "type": "worked-example",
        "statement": "Four choices followed by three remaining choices give twelve ordered officers.",
        "concepts": [
