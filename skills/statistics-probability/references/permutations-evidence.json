        "evidence": [
          {
            "locator": "slide:36/shape:641",
            "quote": "\tKesalahan umum pada permutasi"
          },
          {
            "locator": "slide:36/shape:643",
            "quote": "\tTEMA 3  /  PERMUTASI"
          },
          {
            "locator": "slide:36/shape:647",
            "quote": "\tTANPA PENGULANGAN"
          },
          {
            "locator": "slide:36/shape:648",
            "quote": "\tP(4,2) = 4×3 = 12: orang yang sama tidak boleh mengisi dua posisi sekaligus."
          },
          {
            "locator": "slide:36/shape:650",
            "quote": "\tDENGAN PENGULANGAN"
          },
