        "evidence": [
          {
            "locator": "slide:28/shape:534",
            "quote": "\tJelajahi jawabannya tanpa rumus matematis"
          },
          {
            "locator": "slide:28/shape:536",
            "quote": "\tTEMA 3  /  PERMUTASI"
          },
          {
            "locator": "slide:28/shape:541",
            "quote": "\t1"
          },
          {
            "locator": "slide:28/shape:542",
            "quote": "\tKetua A → 3 calon wakil: B, C, D."
          },
          {
            "locator": "slide:28/shape:545",
            "quote": "\t2"
          },
          {
            "locator": "slide:28/shape:546",
            "quote": "\tKetua B → 3 calon wakil: A, C, D."
          },
          {
            "locator": "slide:28/shape:549",
            "quote": "\t3"
          },
          {
            "locator": "slide:28/shape:550",
            "quote": "\tKetua C dan D pun masing-masing mempunyai 3 calon wakil."
          },
          {
            "locator": "slide:28/shape:553",
            "quote": "\t4"
          },
          {
            "locator": "slide:28/shape:554",
            "quote": "\tTotal 4 × 3 = 12 susunan; pasangan A–B ≠ B–A."
          }
        ],
        "references": []
      }
    ]
  },
