        "evidence": [
          {
            "locator": "slide:32/shape:587",
            "quote": "\tContoh harian: Duduk di kursi"
          },
          {
            "locator": "slide:32/shape:589",
            "quote": "\tTEMA 3  /  PERMUTASI"
          },
          {
            "locator": "slide:32/shape:593",
            "quote": "\t3 ORANG, 3 KURSI"
          },
          {
            "locator": "slide:32/shape:594",
            "quote": "\t6 urutan"
          },
          {
            "locator": "slide:32/shape:595",
            "quote": "\tA, B, C duduk pada 3 kursi berderet. Banyak susunan = 3! = 3×2×1 = 6."
          },
          {
            "locator": "slide:32/shape:597",
            "quote": "\tMakna: kursi pertama, kedua, dan ketiga dianggap berbeda. Jika hanya memilih siapa yang hadir, hasilnya bukan permutasi."
          }
        ],
        "references": []
      }
    ]
  },
