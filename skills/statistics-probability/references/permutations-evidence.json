  {
    "slide": 34,
    "source_sha256": "ab7efabed9af6dec3f902abc3a0143f0301a0383fdce951490fd26e869d5ef1f",
    "summary": "Four deployments have 24 unrestricted orders and twelve when A must precede B; counts do not authorize unsafe release behavior.",
    "issues": [],
    "limitations": [],
    "units": [
      {
        "type": "worked-example",
        "statement": "Four deployments have 24 unrestricted orders and twelve when A must precede B; counts do not authorize unsafe release behavior.",
        "concepts": [
          "permutations"
        ],
        "evidence_label": "LECTURE",
        "evidence": [
          {
            "locator": "slide:34/shape:613",
            "quote": "\tContoh TI: Urutan deployment"
          },
          {
            "locator": "slide:34/shape:615",
            "quote": "\tTEMA 3  /  PERMUTASI"
          },
          {
            "locator": "slide:34/shape:619",
            "quote": "\tMODEL MATEMATIS"
          },
          {
            "locator": "slide:34/shape:620",
            "quote": "\tEmpat perubahan kode A, B, C, D dapat dirilis dalam 4! = 24 urutan jika SEMUA urutan valid."
          },
          {
            "locator": "slide:34/shape:622",
            "quote": "\tMODEL NYATA"
          },
          {
            "locator": "slide:34/shape:623",
            "quote": "\tJika A harus mendahului B karena dependensi, tidak semua 24 urutan aman. Pakar harus mengikuti dependency tersebut."
          },
          {
            "locator": "slide:34/shape:625",
            "quote": "\tJumlah urutan mengungkap kompleksitas, bukan memberi izin mengabaikan prosedur rilis."
          }
        ],
        "references": []
      }
    ]
  },
  {
