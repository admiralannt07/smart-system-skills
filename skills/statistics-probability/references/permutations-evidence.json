        "evidence": [
          {
            "locator": "slide:27/shape:521",
            "quote": "\tTebak-tebakan : Dua posisi"
          },
          {
            "locator": "slide:27/shape:523",
            "quote": "\tTEMA 3  /  PERMUTASI"
          },
          {
            "locator": "slide:27/shape:527",
            "quote": "\tTEBAK DULU"
          },
          {
            "locator": "slide:27/shape:528",
            "quote": "\tDari 4 mahasiswa A, B, C, D, dipilih seorang ketua dan seorang wakil. Tidak boleh orang yang sama. Ada berapa susunan?"
          },
          {
            "locator": "slide:27/shape:530",
            "quote": "\tPETUNJUK"
          },
          {
            "locator": "slide:27/shape:531",
            "quote": "\tA. 6 susunan"
          }
        ],
        "references": []
      }
    ]
